# ============================================================
#  Staging environment variables — set these in the Netlify
#  dashboard for the yfb-staging site (NOT in the repo).
# ============================================================

# ── Supabase (TEST project) ──────────────────────────────────
SUPABASE_URL=https://XXXX.supabase.co          # test project URL
SUPABASE_KEY=eyJ...                             # test project anon key
SUPABASE_SERVICE_KEY=eyJ...                     # test project service-role key

# ── Razorpay TEST mode ───────────────────────────────────────
# Get from: razorpay.com → Settings → API Keys → Test Mode
RAZORPAY_KEY_ID=rzp_test_XXXXXXXXXX
RAZORPAY_KEY_SECRET=XXXXXXXXXXXXXXXXXX

# ── Shopify (shared with production — read-heavy, low risk) ──
SHOPIFY_DOMAIN=zgqk4e-1m.myshopify.com
SHOPIFY_ADMIN_TOKEN=shpat_XXXX                  # same as prod

# ── n8n webhooks (optional — leave blank to skip) ───────────
# N8N_NEW_SUB_NOTIFY_URL=
# N8N_WEBHOOK_URL=

# ── Admin setup ──────────────────────────────────────────────
# After deploying, hit /.netlify/functions/admin-setup once
# to seed the first admin account in the test Supabase.
